# npm registry configuration
# Project-level .npmrc — committed to version control

# Default registry (use Artifactory for corporate environments)
registry=https://artifactory.yourorg.com/api/npm/npm-virtual/

# Auth token for the registry (set via environment variable, never hardcode)
//artifactory.yourorg.com/api/npm/npm-virtual/:_authToken=${NPM_TOKEN}

# Scoped package registry (e.g., internal packages under @yourorg)
@yourorg:registry=https://artifactory.yourorg.com/api/npm/npm-private/

# Cache configuration
cache=.npm-cache
prefer-offline=true

# Strict settings for CI reproducibility
engine-strict=true
save-exact=true
