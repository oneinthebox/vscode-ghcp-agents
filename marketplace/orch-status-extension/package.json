{
  "name": "orch-status",
  "displayName": "ORCH Status",
  "description": "Glanceable status bar for ORCH agent sessions — shows work progress and quality indicator. Notifications only for interrupt-worthy events.",
  "version": "0.1.0",
  "publisher": "orch-team",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": ["Other"],
  "activationEvents": ["workspaceContains:.orch/audit"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "orch.showSessionStatus",
        "title": "ORCH: Show Session Status"
      }
    ]
  }
}
