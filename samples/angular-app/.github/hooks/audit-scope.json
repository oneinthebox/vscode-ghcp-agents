{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "./scripts/audit/check-file-scope.sh",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "./scripts/audit/log-tool-result.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
